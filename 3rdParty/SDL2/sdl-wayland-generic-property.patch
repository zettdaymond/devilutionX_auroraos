--- a/src/video/wayland/SDL_waylandwindow.c
+++ b/src/video/wayland/SDL_waylandwindow.c
@@ -2443,6 +2443,64 @@ void Wayland_QuitWin(SDL_VideoData *data)
     SDL_DelHintCallback(SDL_HINT_VIDEO_EGL_ALLOW_TRANSPARENCY, EGLTransparencyChangedCallback, data);
 }
 
+
+#ifdef SDL_VIDEO_DRIVER_WAYLAND_QT_TOUCH
+/*
+ * Set a generic window property on the qt_extended_surface created by SDL
+ * for this window. The compositor (Lipstick) only honors properties that
+ * arrive through the first extended surface of the underlying wl_surface,
+ * so applications must use this entry point instead of creating their own
+ * qt_extended_surface object.
+ */
+void SDL_WaylandSetWindowGenericProperty(SDL_Window *window, const char *name,
+                                         const void *value, size_t length)
+{
+    SDL_WindowData *wind;
+    struct wl_array array;
+
+    if (window == NULL || window->driverdata == NULL) {
+        return;
+    }
+    wind = (SDL_WindowData *)window->driverdata;
+    if (wind->extended_surface == NULL || name == NULL || value == NULL) {
+        return;
+    }
+
+    array.size = length;
+    array.alloc = 0;
+    array.data = (void *)value;
+    qt_extended_surface_update_generic_property(wind->extended_surface, name, &array);
+}
+
+/*
+ * Make the wl_shell_surface of this window a toplevel. The Aurora/Lipstick
+ * builds have no xdg_wm_base and no libdecor at runtime, and this SDL fork
+ * only issues wl_shell_surface_set_toplevel() from code paths that never run
+ * there (Wayland_SetWindowBordered takes the libdecor no-op branch). A shell
+ * surface without a role is never mapped by the compositor: buffers keep
+ * being committed, but the window never appears and can never be activated.
+ */
+void SDL_WaylandSetWindowShellToplevel(SDL_Window *window)
+{
+    SDL_WindowData *wind;
+    SDL_VideoData *viddata;
+
+    if (window == NULL || window->driverdata == NULL) {
+        return;
+    }
+    wind = (SDL_WindowData *)window->driverdata;
+    viddata = wind->waylandData;
+    if (viddata == NULL || viddata->shell.xdg != NULL) {
+        return; /* xdg-shell assigns the toplevel role on its own */
+    }
+    if (wind->shell_surface.wl == NULL) {
+        return; /* no shell surface yet */
+    }
+    wl_shell_surface_set_toplevel(wind->shell_surface.wl);
+    WAYLAND_wl_display_flush(viddata->display);
+}
+#endif /* SDL_VIDEO_DRIVER_WAYLAND_QT_TOUCH */
+
 #endif /* SDL_VIDEO_DRIVER_WAYLAND */
 
